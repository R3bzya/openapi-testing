{
    "name": "rebzya/openapi-testing",
    "description": "This package allows you to integrate the specification validation into the flow of tests",
    "homepage": "https://github.com/R3bzya/openapi-testing",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "testing"
    ],
    "require": {
        "php": "^8.2",
        "osteel/openapi-httpfoundation-testing": ">=0.11",
        "laravel/framework": ">=10.0 <14.0"
    },
    "require-dev": {
        "orchestra/testbench": ">=8.17 <12.0",
        "phpunit/phpunit": ">=10.5 <13.0"
    },
    "autoload": {
        "psr-4": {
            "Rebzya\\OpenApiTesting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rebzya\\OpenApiTesting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit"
        ]
    },
    "authors": [
        {
            "name": "Aleksei R3bzya Iakushev",
            "email": "aleksei@iakushev.com",
            "homepage": "https://github.com/R3bzya"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
